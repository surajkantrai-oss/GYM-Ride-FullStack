  commissionReversed Int             @default(0) @map("commission_reversed")
  netAmount          Int             @map("net_amount")
  currency           String          @db.Char(3)
  settled            Boolean         @default(false)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  settlementItem     SettlementItem?

  @@index([gymId, settled, createdAt])
  @@map("gym_earnings")
}

model FinancialLedgerEntry {
  id         String         @id @default(uuid()) @db.Uuid
  sourceId   String         @map("source_id") @db.Uuid
  sourceType String         @map("source_type") @db.VarChar(40)
  gymId      String         @map("gym_id") @db.Uuid
  branchId   String?        @map("branch_id") @db.Uuid
  category   LedgerCategory
  account    String         @db.VarChar(40)
  amount     Int
  currency   String         @db.Char(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceId, category, account])
  @@index([gymId, createdAt])
  @@map("financial_ledger_entries")
}

model Settlement {
  id                String              @id @default(uuid()) @db.Uuid
  gymId             String              @map("gym_id") @db.Uuid
  idempotencyKey    String              @unique @map("idempotency_key")
  periodStart       DateTime            @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime            @map("period_end") @db.Timestamptz(6)
  grossAmount       Int                 @map("gross_amount")
  commissionAmount  Int                 @map("commission_amount")
  refundAmount      Int                 @map("refund_amount")
  netAmount         Int                 @map("net_amount")
  currency          String              @db.Char(3)
  status            SettlementStatus    @default(PENDING)
  providerReference String?             @unique @map("provider_reference")
  generatedAt       DateTime            @default(now()) @map("generated_at") @db.Timestamptz(6)
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(6)
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(6)
  items             SettlementItem[]
  reversal          SettlementReversal?

  @@index([gymId, status, generatedAt])
  @@map("settlements")
}

model SettlementItem {
  id           String     @id @default(uuid()) @db.Uuid
  settlementId String     @map("settlement_id") @db.Uuid
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  earningId    String     @unique @map("earning_id") @db.Uuid
  earning      GymEarning @relation(fields: [earningId], references: [id], onDelete: Restrict)
  amount       Int

  @@map("settlement_items")
}

model SettlementReversal {
  id               String     @id @default(uuid()) @db.Uuid
  settlementId     String     @unique @map("settlement_id") @db.Uuid
  settlement       Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  originalLedgerId String     @unique @map("original_ledger_id") @db.Uuid
  idempotencyKey   String     @unique @map("idempotency_key")
  reason           String     @db.VarChar(500)
  actorId          String     @map("actor_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("settlement_reversals")
}

model BookingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @map("booking_id") @db.Uuid
  type        BookingEventType
  fromStatus  BookingStatus?   @map("from_status")
  toStatus    BookingStatus    @map("to_status")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User?            @relation("BookingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([createdAt, id])
  @@index([actorUserId, createdAt])
  @@map("booking_events")
}

model CheckIn {
  id               String                @id @default(uuid()) @db.Uuid
  bookingId        String                @unique @map("booking_id") @db.Uuid
  customerId       String                @map("customer_id") @db.Uuid
  gymId            String                @map("gym_id") @db.Uuid
  branchId         String                @map("branch_id") @db.Uuid
  method           CheckInMethod?
  status           CheckInStatus         @default(AVAILABLE)
  verifiedByUserId String?               @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?             @map("verified_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking          Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer         User                  @relation("CheckInCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  gym              Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  branch           GymBranch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  verifiedBy       User?                 @relation("CheckInVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  tokens           CheckInToken[]
  otpChallenges    CheckInOtpChallenge[]

  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("check_ins")
}

model CheckInToken {
  id         String    @id @default(uuid()) @db.Uuid
  checkInId  String    @map("check_in_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  checkIn    CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Restrict)

  @@index([checkInId, expiresAt])
  @@map("check_in_tokens")
}

model CheckInOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  checkInId   String    @map("check_in_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.Char(64)
  attempts    Int       @default(0) @db.SmallInt
  maxAttempts Int       @map("max_attempts") @db.SmallInt
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  checkIn     CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Restrict)

  @@index([checkInId, createdAt])
  @@index([expiresAt])
  @@map("check_in_otp_challenges")
}
