generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum RoleName {
  CUSTOMER
  GYM_OWNER
  GYM_MANAGER
  GYM_STAFF
  ADMIN
  SUPER_ADMIN
}

enum GymStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum BranchStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum GymMembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  REVIEW_MODERATED
  REFUND_REQUESTED
  SETTLEMENT_GENERATED
  SETTLEMENT_PROCESSING
  SETTLEMENT_PAID
  RECONCILIATION_RUN
  GYM_SUBMITTED
  GYM_APPROVED
  GYM_REJECTED
  GYM_SUSPENDED
  GYM_REACTIVATED
  ROLE_CHANGED
}

enum PlanType {
  DAY_PASS
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SlotStatus {
  AVAILABLE
  BLOCKED
  CLOSED
}

enum AvailabilityExceptionType {
  HOLIDAY
  MAINTENANCE
  PRIVATE_EVENT
  TEMPORARY_CLOSURE
}

enum BookingStatus {
  CREATED
  PAYMENT_PENDING
  CONFIRMED
  CHECK_IN_AVAILABLE
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  PAYMENT_FAILED
  REFUNDED
}

enum BookingEventType {
  BOOKING_CREATED
  BOOKING_EXPIRED
  BOOKING_CANCELLED
  STATUS_CHANGED
  CHECK_IN_AVAILABLE
  QR_TOKEN_ISSUED
  QR_CHECK_IN_VERIFIED
  CHECK_IN_OTP_ISSUED
  OTP_CHECK_IN_VERIFIED
  BOOKING_COMPLETED
  BOOKING_NO_SHOW
}

enum CheckInMethod {
  QR
  OTP
}

enum CheckInStatus {
  AVAILABLE
  VERIFIED
  COMPLETED
  EXPIRED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum NotificationType {
  BOOKING_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  BOOKING_CONFIRMED
  CHECK_IN_AVAILABLE
  CHECKED_IN
  BOOKING_COMPLETED
  BOOKING_NO_SHOW
  BOOKING_CANCELLED
  REFUND_COMPLETED
  REVIEW_AVAILABLE
  REVIEW_RECEIVED
  SETTLEMENT_PAID
}

enum NotificationCategory {
  BOOKING
  PAYMENT
  CHECK_IN
  REFUND
  REVIEW
  SETTLEMENT
  MARKETING
}

enum PushDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  firstName               String?                  @map("first_name") @db.VarChar(100)
  lastName                String?                  @map("last_name") @db.VarChar(100)
  email                   String?                  @unique @db.VarChar(320)
  phone                   String?                  @unique @db.VarChar(32)
  passwordHash            String?                  @map("password_hash") @db.VarChar(255)
  status                  UserStatus               @default(PENDING)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                   UserRole[]
  ownedGyms               Gym[]
  refreshSessions         RefreshSession[]
  gymMemberships          GymMembership[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  bookings                Booking[]
  bookingEvents           BookingEvent[]           @relation("BookingEventActor")
  customerCheckIns        CheckIn[]                @relation("CheckInCustomer")
  verifiedCheckIns        CheckIn[]                @relation("CheckInVerifier")
  reviews                 Review[]                 @relation("ReviewCustomer")
  moderatedReviews        Review[]                 @relation("ReviewModerator")
  notifications           Notification[]
  pushDevices             PushDevice[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Gym {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(160)
  description  String?         @db.Text
  ownerId      String          @map("owner_id") @db.Uuid
  status       GymStatus       @default(DRAFT)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  statusReason String?         @map("status_reason") @db.VarChar(1000)
  submittedAt  DateTime?       @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branches     GymBranch[]
  memberships  GymMembership[]
  plans        GymPlan[]
  bookings     Booking[]
  checkIns     CheckIn[]
  reviews      Review[]

  @@index([ownerId])
  @@index([status])
  @@map("gyms")
}

model GymBranch {
  id             String                                 @id @default(uuid()) @db.Uuid
  gymId          String                                 @map("gym_id") @db.Uuid
  name           String                                 @db.VarChar(160)
  address        String                                 @db.VarChar(255)
  city           String                                 @db.VarChar(120)
  state          String                                 @db.VarChar(120)
  postalCode     String                                 @map("postal_code") @db.VarChar(20)
  country        String                                 @default("IN") @db.VarChar(2)
  latitude       Decimal                                @db.Decimal(9, 6)
  longitude      Decimal                                @db.Decimal(9, 6)
  location       Unsupported("geography(Point, 4326)")?
  phone          String?                                @db.VarChar(32)
  email          String?                                @db.VarChar(320)
  timezone       String                                 @default("Asia/Kolkata") @db.VarChar(64)
  status         BranchStatus                           @default(DRAFT)
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym            Gym                                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  amenities      BranchAmenity[]
  operatingHours OperatingHours[]
  memberships    GymMembership[]
  planLinks      PlanBranch[]
  slotConfig     BranchSlotConfig?
  slots          SlotInstance[]
  exceptions     BranchAvailabilityException[]
  bookings       Booking[]
  checkIns       CheckIn[]
  reviews        Review[]

  @@unique([gymId, name])
  @@index([gymId])
  @@index([city, status])
  @@map("gym_branches")
}

model Amenity {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique @db.VarChar(80)
  name        String          @unique @db.VarChar(120)
  description String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches    BranchAmenity[]

  @@map("amenities")
}

model BranchAmenity {
  branchId  String    @map("branch_id") @db.Uuid
  amenityId String    @map("amenity_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  branch    GymBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  amenity   Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([branchId, amenityId])
  @@index([amenityId])
  @@map("branch_amenities")
}

model OperatingHours {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  weekday   Weekday
  period    Int       @default(1) @db.SmallInt
  opensAt   DateTime? @map("opens_at") @db.Time(0)
  closesAt  DateTime? @map("closes_at") @db.Time(0)
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch    GymBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, weekday, period])
  @@index([branchId, weekday])
  @@map("operating_hours")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  deviceName String?   @map("device_name") @db.VarChar(120)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model GymMembership {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  gymId     String            @map("gym_id") @db.Uuid
  branchId  String?           @map("branch_id") @db.Uuid
  role      GymMembershipRole
  status    MembershipStatus  @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym       Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch    GymBranch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, gymId, branchId, role])
  @@index([gymId, status])
  @@index([branchId, status])
  @@map("gym_memberships")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String      @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(80)
  entityId    String      @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model GymPlan {
  id           String       @id @default(uuid()) @db.Uuid
  gymId        String       @map("gym_id") @db.Uuid
  name         String       @db.VarChar(160)
  description  String?      @db.Text
  type         PlanType
  priceMinor   Int          @map("price_minor")
  currency     String       @default("INR") @db.Char(3)
  durationDays Int          @map("duration_days")
  visitLimit   Int?         @map("visit_limit")
  status       PlanStatus   @default(DRAFT)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  branches     PlanBranch[]
  bookings     Booking[]

  @@index([gymId, status])
  @@map("gym_plans")
}

model PlanBranch {
  planId    String    @map("plan_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  plan      GymPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  branch    GymBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([planId, branchId])
  @@index([branchId])
  @@map("plan_branches")
}

model BranchSlotConfig {
  id                    String    @id @default(uuid()) @db.Uuid
  branchId              String    @unique @map("branch_id") @db.Uuid
  slotDurationMinutes   Int       @map("slot_duration_minutes") @db.SmallInt
  defaultCapacity       Int       @map("default_capacity")
  bookingWindowDays     Int       @default(30) @map("booking_window_days") @db.SmallInt
  minimumAdvanceMinutes Int       @default(60) @map("minimum_advance_minutes")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch                GymBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_slot_configs")
}

model SlotInstance {
  id        String     @id @default(uuid()) @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  startAt   DateTime   @map("start_at") @db.Timestamptz(6)
  endAt     DateTime   @map("end_at") @db.Timestamptz(6)
  capacity  Int
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch    GymBranch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bookings  Booking[]

  @@unique([branchId, startAt, endAt])
  @@index([branchId, startAt, status])
  @@map("slot_instances")
}

model BranchAvailabilityException {
  id        String                    @id @default(uuid()) @db.Uuid
  branchId  String                    @map("branch_id") @db.Uuid
  date      DateTime                  @db.Date
  type      AvailabilityExceptionType
  reason    String?                   @db.VarChar(500)
  isClosed  Boolean                   @default(true) @map("is_closed")
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch    GymBranch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([date])
  @@map("branch_availability_exceptions")
}

model Booking {
  payment              Payment?
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  gymId                String         @map("gym_id") @db.Uuid
  branchId             String         @map("branch_id") @db.Uuid
  planId               String         @map("plan_id") @db.Uuid
  slotId               String?        @map("slot_id") @db.Uuid
  status               BookingStatus  @default(CREATED)
  planName             String         @map("plan_name") @db.VarChar(160)
  planType             PlanType       @map("plan_type")
  priceMinor           Int            @map("price_minor")
  currency             String         @db.Char(3)
  idempotencyKey       String         @map("idempotency_key") @db.VarChar(120)
  requestFingerprint   String         @map("request_fingerprint") @db.Char(64)
  reservationExpiresAt DateTime?      @map("reservation_expires_at") @db.Timestamptz(6)
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  gym                  Gym            @relation(fields: [gymId], references: [id], onDelete: Restrict)
  branch               GymBranch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  plan                 GymPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  slot                 SlotInstance?  @relation(fields: [slotId], references: [id], onDelete: Restrict)
  events               BookingEvent[]
  checkIn              CheckIn?
  review               Review?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([gymId, status, createdAt])
  @@index([slotId, status])
  @@index([reservationExpiresAt, status])
  @@map("bookings")
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  bookingId        String       @unique @map("booking_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  gymId            String       @map("gym_id") @db.Uuid
  branchId         String       @map("branch_id") @db.Uuid
  rating           Int          @db.SmallInt
  title            String?      @db.VarChar(120)
  comment          String?      @db.VarChar(2000)
  status           ReviewStatus @default(PUBLISHED)
  editedAt         DateTime?    @map("edited_at") @db.Timestamptz(6)
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(6)
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  moderationReason String?      @map("moderation_reason") @db.VarChar(500)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking          Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer         User         @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  gym              Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  branch           GymBranch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  moderatedBy      User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([gymId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("reviews")
}

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  type       NotificationType
  category   NotificationCategory
  title      String               @db.VarChar(160)
  body       String               @db.VarChar(500)
  data       Json?
  dedupeKey  String               @unique @map("dedupe_key") @db.VarChar(220)
  readAt     DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model PushDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  sessionId  String?        @map("session_id") @db.Uuid
  platform   String         @db.VarChar(20)
  provider   String         @db.VarChar(30)
  token      String         @db.VarChar(500)
  appVersion String?        @map("app_version") @db.VarChar(50)
  deviceName String?        @map("device_name") @db.VarChar(120)
  enabled    Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@unique([provider, token])
  @@index([userId, enabled])
  @@index([sessionId, enabled])
  @@map("push_devices")
}

model NotificationPreference {
  userId       String               @map("user_id") @db.Uuid
  category     NotificationCategory
  inAppEnabled Boolean              @default(true) @map("in_app_enabled")
  pushEnabled  Boolean              @default(true) @map("push_enabled")
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

model PushDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  notificationId    String             @map("notification_id") @db.Uuid
  deviceId          String             @map("device_id") @db.Uuid
  status            PushDeliveryStatus @default(PENDING)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(160)
  failureCode       String?            @map("failure_code") @db.VarChar(100)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  notification      Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device            PushDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
  @@map("push_deliveries")
}

model NotificationProjectionCursor {
  source        String   @id @db.VarChar(50)
  lastCreatedAt DateTime @map("last_created_at") @db.Timestamptz(6)
  lastId        String   @map("last_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_projection_cursors")
}

model NotificationProjection {
  source    String   @db.VarChar(50)
  sourceId  String   @map("source_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([source, sourceId])
  @@map("notification_projections")
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  READY
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum LedgerCategory {
  CUSTOMER_PAYMENT
  PLATFORM_COMMISSION
  GYM_EARNING
  REFUND
  REFUND_REVERSAL
  SETTLEMENT
  SETTLEMENT_REVERSAL
  MANUAL_ADJUSTMENT
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  bookingId         String           @unique @map("booking_id") @db.Uuid
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider          String           @db.VarChar(30)
  providerOrderId   String?          @unique @map("provider_order_id")
  providerPaymentId String?          @unique @map("provider_payment_id")
  amount            Int
  currency          String           @db.Char(3)
  status            PaymentStatus    @default(CREATED)
  refundedAmount    Int              @default(0) @map("refunded_amount")
  requiresReview    Boolean          @default(false) @map("requires_review")
  capturedAt        DateTime?        @map("captured_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  attempts          PaymentAttempt[]
  refunds           Refund[]
  earning           GymEarning?

  @@index([status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  operationKey      String   @unique @map("operation_key")
  operation         String   @db.VarChar(40)
  status            String   @db.VarChar(30)
  providerReference String?  @map("provider_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String    @db.VarChar(30)
  providerEventId  String    @map("provider_event_id") @db.VarChar(160)
  eventType        String    @map("event_type") @db.VarChar(80)
  payloadHash      String    @map("payload_hash") @db.Char(64)
  reference        String?
  processingStatus String    @default("RECEIVED") @map("processing_status")
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey   String       @unique @map("idempotency_key")
  amount           Int
  reason           String       @db.VarChar(500)
  policyOverride   Boolean      @default(false) @map("policy_override")
  requestedBy      String       @map("requested_by") @db.Uuid
  providerRefundId String?      @unique @map("provider_refund_id")
  status           RefundStatus @default(CREATED)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([paymentId, status])
  @@map("refunds")
}

model GymEarning {
  id                 String          @id @default(uuid()) @db.Uuid
  paymentId          String          @unique @map("payment_id") @db.Uuid
  payment            Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  grossAmount        Int             @map("gross_amount")
  taxAmount          Int             @default(0) @map("tax_amount")
  discountAmount     Int             @default(0) @map("discount_amount")
  commissionAmount   Int             @map("commission_amount")
  commissionBps      Int             @map("commission_bps")
  commissionVersion  String          @map("commission_version")
  refundAmount       Int             @default(0) @map("refund_amount")
  commissionReversed Int             @default(0) @map("commission_reversed")
  netAmount          Int             @map("net_amount")
  currency           String          @db.Char(3)
  settled            Boolean         @default(false)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  settlementItem     SettlementItem?

  @@map("gym_earnings")
}

model FinancialLedgerEntry {
  id         String         @id @default(uuid()) @db.Uuid
  sourceId   String         @map("source_id") @db.Uuid
  sourceType String         @map("source_type") @db.VarChar(40)
  gymId      String         @map("gym_id") @db.Uuid
  branchId   String?        @map("branch_id") @db.Uuid
  category   LedgerCategory
  account    String         @db.VarChar(40)
  amount     Int
  currency   String         @db.Char(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceId, category, account])
  @@index([gymId, createdAt])
  @@map("financial_ledger_entries")
}

model Settlement {
  id                String              @id @default(uuid()) @db.Uuid
  gymId             String              @map("gym_id") @db.Uuid
  idempotencyKey    String              @unique @map("idempotency_key")
  periodStart       DateTime            @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime            @map("period_end") @db.Timestamptz(6)
  grossAmount       Int                 @map("gross_amount")
  commissionAmount  Int                 @map("commission_amount")
  refundAmount      Int                 @map("refund_amount")
  netAmount         Int                 @map("net_amount")
  currency          String              @db.Char(3)
  status            SettlementStatus    @default(PENDING)
  providerReference String?             @unique @map("provider_reference")
  generatedAt       DateTime            @default(now()) @map("generated_at") @db.Timestamptz(6)
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(6)
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(6)
  items             SettlementItem[]
  reversal          SettlementReversal?

  @@index([gymId, status, generatedAt])
  @@map("settlements")
}

model SettlementItem {
  id           String     @id @default(uuid()) @db.Uuid
  settlementId String     @map("settlement_id") @db.Uuid
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  earningId    String     @unique @map("earning_id") @db.Uuid
  earning      GymEarning @relation(fields: [earningId], references: [id], onDelete: Restrict)
  amount       Int

  @@map("settlement_items")
}

model SettlementReversal {
  id               String     @id @default(uuid()) @db.Uuid
  settlementId     String     @unique @map("settlement_id") @db.Uuid
  settlement       Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  originalLedgerId String     @unique @map("original_ledger_id") @db.Uuid
  idempotencyKey   String     @unique @map("idempotency_key")
  reason           String     @db.VarChar(500)
  actorId          String     @map("actor_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("settlement_reversals")
}

model BookingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @map("booking_id") @db.Uuid
  type        BookingEventType
  fromStatus  BookingStatus?   @map("from_status")
  toStatus    BookingStatus    @map("to_status")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User?            @relation("BookingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([createdAt, id])
  @@index([actorUserId, createdAt])
  @@map("booking_events")
}

model CheckIn {
  id               String                @id @default(uuid()) @db.Uuid
  bookingId        String                @unique @map("booking_id") @db.Uuid
  customerId       String                @map("customer_id") @db.Uuid
  gymId            String                @map("gym_id") @db.Uuid
  branchId         String                @map("branch_id") @db.Uuid
  method           CheckInMethod?
  status           CheckInStatus         @default(AVAILABLE)
  verifiedByUserId String?               @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?             @map("verified_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking          Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer         User                  @relation("CheckInCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  gym              Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  branch           GymBranch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  verifiedBy       User?                 @relation("CheckInVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  tokens           CheckInToken[]
  otpChallenges    CheckInOtpChallenge[]

  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("check_ins")
}

model CheckInToken {
  id         String    @id @default(uuid()) @db.Uuid
  checkInId  String    @map("check_in_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  checkIn    CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Restrict)

  @@index([checkInId, expiresAt])
  @@map("check_in_tokens")
}

model CheckInOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  checkInId   String    @map("check_in_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.Char(64)
  attempts    Int       @default(0) @db.SmallInt
  maxAttempts Int       @map("max_attempts") @db.SmallInt
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  checkIn     CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Restrict)

  @@index([checkInId, createdAt])
  @@index([expiresAt])
  @@map("check_in_otp_challenges")
}
