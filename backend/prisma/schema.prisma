model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  firstName               String?                  @map("first_name") @db.VarChar(100)
  lastName                String?                  @map("last_name") @db.VarChar(100)
  email                   String?                  @unique @db.VarChar(320)
  phone                   String?                  @unique @db.VarChar(32)
  passwordHash            String?                  @map("password_hash") @db.VarChar(255)
  status                  UserStatus               @default(PENDING)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                   UserRole[]
  ownedGyms               Gym[]
  refreshSessions         RefreshSession[]
  gymMemberships          GymMembership[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  bookings                Booking[]
  bookingEvents           BookingEvent[]           @relation("BookingEventActor")
  customerCheckIns        CheckIn[]                @relation("CheckInCustomer")
  verifiedCheckIns        CheckIn[]                @relation("CheckInVerifier")
  reviews                 Review[]                 @relation("ReviewCustomer")
  moderatedReviews        Review[]                 @relation("ReviewModerator")
  notifications           Notification[]
  pushDevices             PushDevice[]
  notificationPreferences NotificationPreference[]
  primaryFlexCity         ServiceCity?             @relation("UserPrimaryFlexCity", fields: [primaryFlexCityId], references: [id], onDelete: SetNull)
  secondaryFlexCity       ServiceCity?             @relation("UserSecondaryFlexCity", fields: [secondaryFlexCityId], references: [id], onDelete: SetNull)
  primaryFlexCityId       String?                  @map("primary_flex_city_id") @db.Uuid
  secondaryFlexCityId     String?                  @map("secondary_flex_city_id") @db.Uuid
  flexSubscriptions       FlexSubscription[]
  flexUsages              FlexUsage[]
  gymPreference           CustomerGymPreference?
  linkedGymMembers        GymMember[]              @relation("GymMemberUser")
  createdGymMembers       GymMember[]              @relation("GymMemberCreator")
  updatedGymMembers       GymMember[]              @relation("GymMemberUpdater")
  createdMembershipPlans  GymOsMembershipPlan[]    @relation("MembershipPlanCreator")
  updatedMembershipPlans  GymOsMembershipPlan[]    @relation("MembershipPlanUpdater")
  createdMemberships      GymOsMembership[]        @relation("MembershipCreator")
  updatedMemberships      GymOsMembership[]        @relation("MembershipUpdater")
  membershipEvents        GymOsMembershipEvent[]   @relation("MembershipEventActor")
  recordedGymOsAttendances GymOsAttendance[]        @relation("AttendanceRecorder")

  @@map("users")
}

model CustomerGymPreference {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  preferredAmenities      String[]  @default([]) @map("preferred_amenities")
  preferredPlanType       PlanType? @map("preferred_plan_type")
  preferredWorkoutHour    Int?      @map("preferred_workout_hour") @db.SmallInt
  preferredRadiusKm       Int       @default(10) @map("preferred_radius_km") @db.SmallInt
  preferredBudgetMinMinor Int?      @map("preferred_budget_min_minor")
  preferredBudgetMaxMinor Int?      @map("preferred_budget_max_minor")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_gym_preferences")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Gym {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String                 @db.VarChar(160)
  description        String?                @db.Text
  ownerId            String                 @map("owner_id") @db.Uuid
  status             GymStatus              @default(DRAFT)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  statusReason       String?                @map("status_reason") @db.VarChar(1000)
  submittedAt        DateTime?              @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  owner              User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branches           GymBranch[]
  memberships        GymMembership[]
  plans              GymPlan[]
  bookings           Booking[]
  checkIns           CheckIn[]
  reviews            Review[]
  flexParticipations GymFlexParticipation[]
  flexUsages         FlexUsage[]
  gymOsSubscriptions GymOsSubscription[]
  gymOsMembers       GymMember[]
  gymOsMembershipPlans GymOsMembershipPlan[]
  gymOsMemberships GymOsMembership[]
  gymOsMembershipEvents GymOsMembershipEvent[]
  gymOsAttendances GymOsAttendance[]
  gymOsAttendanceQrTokens GymOsAttendanceQrToken[]
  gymOsMemberCharges GymOsMemberCharge[]
  gymOsMemberPayments GymOsMemberPayment[]
  gymOsMemberReceipts GymOsMemberReceipt[]
  gymOsReceiptCounters GymOsReceiptCounter[]
  gymOsReminderRules GymOsReminderRule[]
  gymOsReminderDeliveries GymOsReminderDelivery[]
  gymOsCommunicationPreferences GymOsMemberCommunicationPreference[]
  gymOsReminderCampaigns GymOsReminderCampaign[]

  @@index([ownerId])
  @@index([status])
  @@map("gyms")
}

model GymMember {
  id                    String          @id @default(uuid()) @db.Uuid
  gymId                 String          @map("gym_id") @db.Uuid
  primaryBranchId       String?         @map("primary_branch_id") @db.Uuid
  userId                String?         @map("user_id") @db.Uuid
  memberCode            String          @map("member_code") @db.VarChar(32)
  firstName             String          @map("first_name") @db.VarChar(100)
  lastName              String?         @map("last_name") @db.VarChar(100)
  phone                 String          @db.VarChar(32)
  email                 String?         @db.VarChar(320)
  dateOfBirth           DateTime?       @map("date_of_birth") @db.Date
  joinedAt              DateTime?       @map("joined_at") @db.Date
  notes                 String?         @db.VarChar(2000)
  emergencyContactName  String?         @map("emergency_contact_name") @db.VarChar(160)
  emergencyContactPhone String?         @map("emergency_contact_phone") @db.VarChar(32)
  addressLine1          String?         @map("address_line_1") @db.VarChar(255)
  city                  String?         @db.VarChar(120)
  state                 String?         @db.VarChar(120)
  postalCode            String?         @map("postal_code") @db.VarChar(20)
  country               String?         @db.Char(2)
  status                GymMemberStatus @default(ACTIVE)
  archivedAt            DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdByUserId       String          @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?         @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym                   Gym             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  primaryBranch         GymBranch?      @relation(fields: [primaryBranchId], references: [id], onDelete: SetNull)
  user                  User?           @relation("GymMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy             User            @relation("GymMemberCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             User?           @relation("GymMemberUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  memberships           GymOsMembership[]
  membershipEvents      GymOsMembershipEvent[]
  attendances            GymOsAttendance[]
  charges                GymOsMemberCharge[]
  payments               GymOsMemberPayment[]
  reminderDeliveries GymOsReminderDelivery[]
  communicationPreference GymOsMemberCommunicationPreference?

  @@unique([gymId, memberCode])
  @@unique([gymId, phone])
  @@index([gymId, status])
  @@index([gymId, primaryBranchId])
  @@index([gymId, firstName, lastName])
  @@map("gym_members")
}

model GymOsMembershipPlan {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  name String @db.VarChar(120)
  code String @db.VarChar(50)
  description String? @db.VarChar(1000)
  status GymOsMembershipPlanStatus @default(DRAFT)
  durationType GymOsMembershipDurationType @map("duration_type")
  durationValue Int @map("duration_value")
  priceMinor Int @map("price_minor")
  currency String @default("INR") @db.Char(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)
  createdBy User @relation("MembershipPlanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User? @relation("MembershipPlanUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  branches GymOsMembershipPlanBranch[]
  memberships GymOsMembership[]
  @@unique([gymId, code])
  @@index([gymId, status])
  @@map("gym_os_membership_plans")
}

model GymOsMembershipPlanBranch {
  planId String @map("plan_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  plan GymOsMembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  branch GymBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@id([planId, branchId])
  @@index([branchId])
  @@map("gym_os_membership_plan_branches")
}

model GymOsMembership {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  membershipPlanId String @map("membership_plan_id") @db.Uuid
  status GymOsMembershipStatus
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  planNameSnapshot String @map("plan_name_snapshot") @db.VarChar(120)
  planCodeSnapshot String @map("plan_code_snapshot") @db.VarChar(50)
  durationTypeSnapshot GymOsMembershipDurationType @map("duration_type_snapshot")
  durationValueSnapshot Int @map("duration_value_snapshot")
  priceMinorSnapshot Int @map("price_minor_snapshot")
  currencySnapshot String @map("currency_snapshot") @db.Char(3)
  branchIdsSnapshot String[] @map("branch_ids_snapshot") @db.Uuid
  freezeStartedAt DateTime? @map("freeze_started_at") @db.Timestamptz(6)
  totalFrozenDays Int @default(0) @map("total_frozen_days")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)
  expiredAt DateTime? @map("expired_at") @db.Timestamptz(6)
  renewedFromMembershipId String? @unique @map("renewed_from_membership_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membershipPlan GymOsMembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  renewedFrom GymOsMembership? @relation("MembershipRenewal", fields: [renewedFromMembershipId], references: [id], onDelete: Restrict)
  renewedTo GymOsMembership? @relation("MembershipRenewal")
  createdBy User @relation("MembershipCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User? @relation("MembershipUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  events GymOsMembershipEvent[]
  attendances GymOsAttendance[]
  charge GymOsMemberCharge?
  @@index([gymId, status])
  @@index([memberId])
  @@index([endDate])
  @@index([startDate])
  @@index([membershipPlanId])
  @@map("gym_os_memberships")
}

model GymOsMemberCharge {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  membershipId String @unique @map("membership_id") @db.Uuid
  type GymOsMemberChargeType
  description String @db.VarChar(255)
  amountMinor Int @map("amount_minor")
  currency String @db.Char(3)
  dueDate DateTime @map("due_date") @db.Date
  status GymOsMemberChargeStatus @default(UNPAID)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason String? @map("void_reason") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership GymOsMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  allocations GymOsPaymentAllocation[]
  @@index([gymId, dueDate])
  @@index([gymId, memberId])
  @@index([gymId, status])
  @@map("gym_os_member_charges")
}

model GymOsMemberPayment {
  id String @id @default(uuid()) @db.Uuid
  gymId String @map("gym_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  amountMinor Int @map("amount_minor")
  currency String @db.Char(3)
  method GymOsMemberPaymentMethod
  status GymOsMemberPaymentStatus @default(RECORDED)
  source String @default("MANUAL") @db.VarChar(20)
  paidAt DateTime @map("paid_at") @db.Timestamptz(6)
  reference String? @db.VarChar(160)
  notes String? @db.VarChar(1000)
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.VarChar(160)
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversedByUserId String? @map("reversed_by_user_id") @db.Uuid
  reversalReason String? @map("reversal_reason") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
