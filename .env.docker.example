# Copy to .env.docker before running Docker Compose. Values below are local-only
# placeholders; replace every secret before using this configuration elsewhere.
NODE_ENV=development
PAYMENT_PROVIDER=development
PUSH_PROVIDER=development
NOTIFICATION_QUEUE_ENABLED=false
BOOKING_QUEUE_ENABLED=false
CHECK_IN_QUEUE_ENABLED=false
GYMOS_REMINDER_QUEUE_ENABLED=false
GYMOS_RECONCILIATION_ENABLED=true

POSTGRES_DB=gymride
POSTGRES_USER=gymride
POSTGRES_PASSWORD=replace-with-local-db-password
DATABASE_URL=postgresql://gymride:replace-with-local-db-password@postgres:5432/gymride?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

JWT_ACCESS_SECRET=replace-with-random-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-random-32-char-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_HASH_SECRET=replace-with-random-32-char-otp-hash-secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=3600

CHECK_IN_TOKEN_SECRET=replace-with-random-32-char-checkin-secret
CHECK_IN_TOKEN_TTL_SECONDS=180
CHECK_IN_OPEN_BEFORE_MINUTES=15
CHECK_IN_CLOSE_AFTER_MINUTES=30
CHECK_IN_COMPLETION_GRACE_MINUTES=15
CHECK_IN_OTP_TTL_SECONDS=180
CHECK_IN_OTP_MAX_ATTEMPTS=5
CHECK_IN_OTP_RESEND_COOLDOWN_SECONDS=30
CHECK_IN_OTP_REQUEST_LIMIT=5
CHECK_IN_OTP_REQUEST_WINDOW_SECONDS=3600

BOOKING_RESERVATION_TTL_SECONDS=600
BOOKING_LOCK_TTL_SECONDS=15
GYMOS_ATTENDANCE_QR_TTL_SECONDS=60
GYMOS_ATTENDANCE_QR_RETENTION_HOURS=24
DEFAULT_PLATFORM_COMMISSION_BPS=1500
REFUND_MINIMUM_HOURS=2

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEV_SEED_OWNER_PHONE=
DEV_SEED_ADMIN_PHONE=

